# LLM API Keys (Supports Gemini and Groq)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=your_backup_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Telemetry & System Config
SYNTHESIZER_MODEL=gemini-3.8-flash
CONTROLLER_MODEL=gemini-3.8-flash
DECOMPOSER_MODEL=gemini-3.8-flash
MONITOR_MODEL=gemini-3.8-flash
VALIDATOR_MODEL=gemini-3.8-flash

# Logging Level
LOG_LEVEL=INFO
